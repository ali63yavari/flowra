##################################################
# GLOBAL (applies to entire repo)
##################################################

# OS / Editor
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# Logs
*.log
logs/
tmp/

# Env files (keep templates only)
.env
.env.local
.env.*.local

##################################################
# BACKEND (Go - ./backend)
##################################################

/backend/bin/
/backend/build/
/backend/dist/

# Go build artifacts
/backend/*.exe
/backend/*.exe~
/backend/*.dll
/backend/*.so
/backend/*.dylib

# Test binary
/backend/*.test

# Coverage
/backend/coverage.out
/backend/coverage.html

# Vendor (optional: comment if you vendor deps)
/backend/vendor/

# Go workspace (if used)
/backend/go.work
/backend/go.work.sum

# Air / live reload
/backend/tmp/

##################################################
# DATABASE / MIGRATIONS (IMPORTANT)
##################################################

# DO NOT ignore migrations (you want these in git)
# /migrations/

# But ignore local DB files
*.sqlite
*.db

##################################################
# FRONTEND (Next.js - ./frontend)
##################################################

/frontend/node_modules/
/frontend/.next/
/frontend/out/
/frontend/build/

# Logs
/frontend/npm-debug.log*
/frontend/yarn-debug.log*
/frontend/yarn-error.log*
/frontend/pnpm-debug.log*

# Env files
/frontend/.env*
!/frontend/.env.example

# Next.js cache
/frontend/.turbo/
/frontend/.cache/

# TypeScript
/frontend/tsconfig.tsbuildinfo

##################################################
# PACKAGE MANAGERS
##################################################

# Lockfiles (keep ONE depending on your choice)
# Uncomment based on your tool:

# npm
# package-lock.json

# yarn
# yarn.lock

# pnpm
# pnpm-lock.yaml

##################################################
# DOCKER / DEVOPS
##################################################

docker-compose.override.yml
*.local.yml

##################################################
# TESTING / TEMP
##################################################

*.tmp
*.temp

##################################################
# SECURITY
##################################################

# Never commit secrets
secrets/
*.key
*.pem
*.crt

##################################################
# MISC
##################################################

coverage/
dist/