# Local backend defaults for running the API/worker outside Docker.
DATABASE_DSN=postgres://flowra:flowra@localhost:5432/flowra?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_QUEUE=flowra_jobs
PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
FLOWRA_SECRET_KEY=local-development-secret-change-me
FLOWRA_SEED_TENANT_ID=local-tenant
FLOWRA_SEED_TENANT_NAME=Local Flowra Workspace
FLOWRA_SEED_API_KEY=local-flowra-key
