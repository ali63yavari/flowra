# Local Docker defaults only. Change these values before using a shared environment.
DATABASE_DSN=postgres://flowra:flowra@postgres:5432/flowra?sslmode=disable
REDIS_ADDR=redis:6379
REDIS_QUEUE=flowra_jobs
PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
FLOWRA_SECRET_KEY=local-development-secret-change-me

# Seeded local tenant so the frontend can call the API immediately.
FLOWRA_SEED_TENANT_ID=local-tenant
FLOWRA_SEED_TENANT_NAME=Local Flowra Workspace
FLOWRA_SEED_API_KEY=local-flowra-key
